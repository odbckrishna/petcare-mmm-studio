# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Sample data and the blank template ARE tracked (~9 MB) so the repo works on
# clone with no setup. Regenerate them with:
#   python scripts/generate_sample_data.py   (or util\install.bat)
# Uploaded workbooks from the UI are not tracked - only the known samples.
data/*.xlsm
data/*.xls
data/.cache/

# Meridian reports and job state
reports/*.html
reports/_job/

# Runtime logs
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ...but keep the directories themselves
!data/.gitkeep
!reports/.gitkeep
!templates/.gitkeep

# Excel lock/temp artifacts
~$*
data/[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]
util/_*.txt
